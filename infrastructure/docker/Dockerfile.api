FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN groupadd --system mednexus && useradd --system --gid mednexus --home /app mednexus

WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN python -m pip install --no-cache-dir --upgrade pip && \
    python -m pip install --no-cache-dir '.[api,ml,ai]'

USER mednexus

EXPOSE 8000
CMD ["uvicorn", "mednexus.api.app:app", "--host", "0.0.0.0", "--port", "8000"]
