FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYSPARK_PYTHON=python3 \
    PYSPARK_DRIVER_PYTHON=python3

# Native dependencies required by confluent-kafka.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        openjdk-17-jre-headless \
        librdkafka-dev \
        gcc \
        g++ \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --system spark && useradd --system --gid spark --home /opt/mednexus spark

WORKDIR /opt/mednexus

COPY pyproject.toml ./
COPY src ./src

RUN python -m pip install --no-cache-dir \
    --upgrade pip setuptools wheel && \
    python -m pip install --no-cache-dir '.[spark]'

USER spark
