# ==========================================
# MEDNEXUS AI - LOCAL DEVELOPMENT
# ==========================================

# PostgreSQL
POSTGRES_DB=mednexus
POSTGRES_USER=mednexus
POSTGRES_PASSWORD=mednexus_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

DATABASE_URL=postgresql://mednexus:mednexus_dev_password@localhost:55432/mednexus

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# MinIO
MINIO_ROOT_USER=mednexus
MINIO_ROOT_PASSWORD=mednexus_dev_storage
MINIO_ENDPOINT=http://localhost:9000

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# AI
HF_HOME=/app/.cache/huggingface

# Epic SMART on FHIR (disabled until an Epic non-production app is registered)
EPIC_SMART_ENABLED=false
EPIC_FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
EPIC_CLIENT_ID=
EPIC_REDIRECT_URI=http://localhost:8000/api/v1/integrations/epic/callback
EPIC_SMART_SCOPES=openid fhirUser launch/patient patient/Patient.rs patient/Encounter.rs patient/Observation.rs offline_access
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EPIC_STATE_ENCRYPTION_KEY=
EPIC_SESSION_TTL_SECONDS=3600
WEB_BASE_URL=http://localhost:5173
